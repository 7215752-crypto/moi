:root {
  --background: #f4f1ea;
  --surface: #fffdf8;
  --surface-strong: #ffffff;
  --ink: #1c211d;
  --muted: #6d746e;
  --line: #dedbd2;
  --brand: #b6402f;
  --brand-dark: #843126;
  --brand-soft: #f5ddd7;
  --green: #2c7355;
  --green-soft: #dcecdf;
  --amber: #8a681f;
  --amber-soft: #f6ebc9;
  --shadow: 0 18px 50px rgba(48, 43, 31, 0.08);
  --radius: 22px;
}

* {
  box-sizing: border-box;
}

html {
  background: var(--background);
}

body {
  margin: 0;
  color: var(--ink);
  background:
    radial-gradient(circle at 8% 8%, rgba(182, 64, 47, 0.08), transparent 28rem),
    var(--background);
  font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  min-height: 100vh;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1 {
  margin-bottom: 12px;
  font-size: clamp(34px, 4vw, 54px);
  line-height: 1.02;
  letter-spacing: -0.04em;
}

h2 {
  margin-bottom: 8px;
  font-size: 25px;
  letter-spacing: -0.025em;
}

h3 {
  margin-bottom: 4px;
  font-size: 19px;
}

.eyebrow {
  margin-bottom: 10px;
  color: var(--brand);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.eyebrow.light {
  color: #f2b5a8;
}

.muted {
  color: var(--muted);
}

.muted.wide {
  max-width: 680px;
  line-height: 1.65;
}

.login-shell {
  display: grid;
  grid-template-columns: minmax(0, 1.08fr) minmax(460px, 0.92fr);
  min-height: 100vh;
}

.login-brand-panel {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: clamp(48px, 8vw, 120px);
  color: white;
  background:
    linear-gradient(135deg, rgba(28, 33, 29, 0.2), transparent),
    #8f3025;
  position: relative;
  overflow: hidden;
}

.login-brand-panel::after {
  content: "";
  position: absolute;
  right: -130px;
  bottom: -150px;
  width: 480px;
  height: 480px;
  border: 80px solid rgba(255, 255, 255, 0.07);
  border-radius: 50%;
}

.brand-mark,
.mini-brand-mark {
  display: grid;
  place-items: center;
  color: white;
  background: var(--brand);
  border-radius: 13px;
  font-family: Georgia, serif;
  font-weight: 700;
}

.brand-mark {
  width: 62px;
  height: 62px;
  margin-bottom: 34px;
  background: #f2c7bd;
  color: var(--brand-dark);
  font-size: 32px;
  box-shadow: 0 12px 30px rgba(28, 19, 16, 0.2);
}

.login-brand-panel h1 {
  max-width: 650px;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(48px, 6vw, 78px);
  font-weight: 500;
  letter-spacing: -0.045em;
}

.login-brand-panel > p:not(.eyebrow) {
  max-width: 580px;
  color: rgba(255, 255, 255, 0.78);
  font-size: 18px;
  line-height: 1.7;
}

.login-feature-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 180px));
  gap: 18px;
  margin-top: 44px;
}

.login-feature-grid div {
  padding: 18px 0;
  border-top: 1px solid rgba(255, 255, 255, 0.2);
}

.login-feature-grid strong,
.login-feature-grid span {
  display: block;
}

.login-feature-grid strong {
  margin-bottom: 5px;
  font-size: 28px;
}

.login-feature-grid span {
  color: rgba(255, 255, 255, 0.68);
  font-size: 13px;
  line-height: 1.4;
}

.login-card-wrap {
  display: grid;
  place-items: center;
  padding: 42px;
}

.login-card {
  width: min(100%, 440px);
  padding: 44px;
  background: var(--surface-strong);
  border: 1px solid rgba(222, 219, 210, 0.8);
  border-radius: 28px;
  box-shadow: var(--shadow);
}

.login-card h2 {
  font-size: 32px;
}

.login-form {
  display: grid;
  gap: 20px;
  margin-top: 28px;
}

.login-form label {
  display: grid;
  gap: 8px;
}

.login-form label span,
.filter-form label {
  color: #464c47;
  font-size: 13px;
  font-weight: 700;
}

.login-form input,
.filter-form select {
  width: 100%;
  min-height: 49px;
  padding: 0 15px;
  color: var(--ink);
  background: #faf9f5;
  border: 1px solid var(--line);
  border-radius: 13px;
  outline: none;
  transition: 0.2s ease;
}

.login-form input:focus,
.filter-form select:focus {
  border-color: var(--brand);
  box-shadow: 0 0 0 4px var(--brand-soft);
}

.primary-button,
.secondary-button,
.ghost-button {
  border: 0;
  border-radius: 12px;
  cursor: pointer;
  font-weight: 750;
  transition: transform 0.16s ease, opacity 0.16s ease, background 0.16s ease;
}

.primary-button:hover,
.secondary-button:hover,
.ghost-button:hover {
  transform: translateY(-1px);
}

.primary-button:disabled {
  cursor: wait;
  opacity: 0.65;
}

.primary-button {
  min-height: 51px;
  padding: 0 20px;
  color: white;
  background: var(--brand);
  box-shadow: 0 10px 22px rgba(182, 64, 47, 0.2);
}

.secondary-button {
  min-height: 45px;
  padding: 0 17px;
  color: var(--brand-dark);
  background: var(--brand-soft);
}

.ghost-button {
  min-height: 39px;
  padding: 0 15px;
  color: var(--ink);
  background: #f0ede6;
}

.privacy-note {
  margin: 23px 0 0;
  color: #8c918d;
  font-size: 12px;
  line-height: 1.55;
}

.alert {
  margin-top: 19px;
  padding: 13px 15px;
  color: #7b2820;
  background: #fbe5e1;
  border: 1px solid #edc6be;
  border-radius: 12px;
  font-size: 14px;
}

.app-shell {
  min-height: 100vh;
}

.site-header {
  position: sticky;
  z-index: 10;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76px;
  padding: 0 max(28px, calc((100vw - 1240px) / 2));
  background: rgba(255, 253, 248, 0.88);
  border-bottom: 1px solid rgba(222, 219, 210, 0.85);
  backdrop-filter: blur(18px);
}

.brand-link,
.header-user {
  display: flex;
  align-items: center;
}

.brand-link {
  gap: 13px;
}

.brand-link > span:last-child,
.header-user > div {
  display: grid;
  gap: 2px;
}

.brand-link small,
.header-user span {
  color: var(--muted);
  font-size: 12px;
}

.mini-brand-mark {
  width: 39px;
  height: 39px;
  font-size: 21px;
}

.header-user {
  gap: 19px;
}

.header-user > div {
  text-align: right;
}

.page-container {
  width: min(1240px, calc(100% - 48px));
  margin: 0 auto;
  padding: 52px 0 80px;
}

.page-container.narrow {
  width: min(920px, calc(100% - 48px));
}

.hero-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;
  margin-bottom: 34px;
}

.hero-row.compact {
  align-items: center;
}

.hero-date {
  display: grid;
  min-width: 200px;
  padding: 17px 20px;
  background: rgba(255, 253, 248, 0.66);
  border: 1px solid var(--line);
  border-radius: 16px;
}

.hero-date span {
  margin-bottom: 6px;
  color: var(--muted);
  font-size: 12px;
}

.hero-date strong {
  font-size: 14px;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}

.metric-grid.four {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.metric-card {
  min-height: 158px;
  padding: 23px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 19px;
  box-shadow: 0 8px 24px rgba(48, 43, 31, 0.035);
}

.metric-card.accent {
  color: white;
  background: linear-gradient(135deg, var(--brand), #963225);
  border-color: transparent;
}

.metric-card span,
.metric-card strong,
.metric-card small {
  display: block;
}

.metric-card > span {
  color: var(--muted);
  font-size: 13px;
}

.metric-card.accent > span,
.metric-card.accent small {
  color: rgba(255, 255, 255, 0.72);
}

.metric-card strong {
  margin: 17px 0 13px;
  font-size: 35px;
  letter-spacing: -0.04em;
}

.metric-card strong.metric-date {
  font-size: 21px;
  line-height: 1.25;
}

.metric-card strong.metric-money {
  font-size: clamp(22px, 2.3vw, 32px);
}

.metric-card small {
  color: #858b86;
  font-size: 12px;
  line-height: 1.45;
}

.content-card {
  margin-top: 22px;
  padding: 28px;
  background: var(--surface-strong);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: 0 12px 35px rgba(48, 43, 31, 0.04);
}

.content-card.slim {
  padding-bottom: 20px;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 22px;
}

.section-heading p {
  margin: 0;
  color: var(--muted);
  font-size: 14px;
}

.period-list {
  display: grid;
}

.period-row {
  display: grid;
  grid-template-columns: 57px minmax(220px, 1fr) minmax(170px, auto) auto 28px;
  align-items: center;
  gap: 20px;
  padding: 18px 8px;
  border-top: 1px solid #ebe8e1;
  transition: background 0.16s ease;
}

.period-row:first-child {
  border-top: 0;
}

.period-row:hover {
  background: #faf7f1;
  border-radius: 14px;
}

.period-icon {
  display: grid;
  place-items: center;
  width: 50px;
  height: 50px;
  background: var(--brand-soft);
  border-radius: 13px;
}

.period-icon span,
.period-icon small {
  display: block;
  line-height: 1;
}

.period-icon span {
  color: var(--brand-dark);
  font-size: 18px;
  font-weight: 800;
}

.period-icon small {
  color: var(--brand);
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
}

.period-main,
.period-total {
  display: grid;
  gap: 5px;
}

.period-main span,
.period-total span {
  color: var(--muted);
  font-size: 12px;
}

.period-total {
  text-align: right;
}

.period-total strong {
  font-size: 16px;
}

.row-arrow {
  color: var(--brand);
  font-size: 21px;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 28px;
  padding: 0 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 800;
  white-space: nowrap;
}

.status-draft {
  color: #765c19;
  background: var(--amber-soft);
}

.status-review {
  color: #654d8b;
  background: #eee6f8;
}

.status-approved,
.status-paid {
  color: var(--green);
  background: var(--green-soft);
}

.status-exported {
  color: #2d617b;
  background: #dfeef4;
}

.breadcrumbs {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 34px;
  color: var(--muted);
  font-size: 13px;
}

.breadcrumbs a:hover {
  color: var(--brand);
}

.breadcrumbs strong {
  color: var(--ink);
}

.title-with-status {
  display: flex;
  align-items: center;
  gap: 14px;
}

.title-with-status h1 {
  margin-bottom: 0;
}

.filter-form {
  display: grid;
  grid-template-columns: minmax(180px, 250px) auto;
  align-items: end;
  gap: 10px;
}

.filter-form label {
  grid-column: 1;
}

.filter-form select {
  grid-column: 1;
  grid-row: 2;
  min-height: 45px;
}

.filter-form button {
  grid-column: 2;
  grid-row: 2;
}

.unit-groups {
  display: grid;
  gap: 31px;
}

.unit-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 5px 13px;
}

.unit-heading span {
  color: var(--muted);
  font-size: 12px;
}

.unit-heading > strong {
  font-size: 19px;
}

.payroll-table-wrap {
  overflow: hidden;
  border: 1px solid #e5e1d8;
  border-radius: 15px;
}

.payroll-table {
  width: 100%;
  border-collapse: collapse;
}

.payroll-table th,
.payroll-table td {
  padding: 14px 16px;
  text-align: left;
  border-bottom: 1px solid #eeeae3;
}

.payroll-table th {
  color: #777d78;
  background: #f8f6f0;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.payroll-table td {
  font-size: 14px;
}

.payroll-table tr:last-child td {
  border-bottom: 0;
}

.payroll-table tbody tr:hover {
  background: #fbf8f2;
}

.payroll-table .numeric {
  text-align: right;
}

.money-cell {
  font-variant-numeric: tabular-nums;
  font-weight: 800;
}

.open-cell {
  width: 52px;
  text-align: center !important;
}

.open-cell a {
  display: grid;
  place-items: center;
  width: 31px;
  height: 31px;
  margin-left: auto;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 9px;
  font-weight: 800;
}

.misc-list {
  display: grid;
}

.misc-list > div {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 15px 3px;
  border-top: 1px solid #ece8e0;
}

.misc-list > div:first-child {
  border-top: 0;
}

.employee-summary-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  padding: 35px;
  color: white;
  background:
    radial-gradient(circle at 80% 15%, rgba(255, 255, 255, 0.15), transparent 15rem),
    linear-gradient(135deg, #913225, #6f281f);
  border-radius: 25px;
  box-shadow: 0 20px 45px rgba(95, 39, 31, 0.18);
}

.employee-summary-card h1 {
  margin-bottom: 9px;
  font-family: Georgia, serif;
  font-weight: 500;
}

.employee-summary-card p:not(.eyebrow) {
  margin-bottom: 0;
  color: rgba(255, 255, 255, 0.7);
}

.salary-total {
  display: grid;
  min-width: 230px;
  padding-left: 28px;
  text-align: right;
  border-left: 1px solid rgba(255, 255, 255, 0.18);
}

.salary-total span,
.salary-total small {
  color: rgba(255, 255, 255, 0.64);
}

.salary-total strong {
  margin: 7px 0;
  font-size: 37px;
  letter-spacing: -0.04em;
  font-variant-numeric: tabular-nums;
}

.mini-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 13px;
  margin-top: 17px;
}

.mini-metrics article {
  padding: 19px 21px;
  background: var(--surface-strong);
  border: 1px solid var(--line);
  border-radius: 16px;
}

.mini-metrics span,
.mini-metrics strong {
  display: block;
}

.mini-metrics span {
  margin-bottom: 9px;
  color: var(--muted);
  font-size: 12px;
}

.mini-metrics strong {
  font-size: 20px;
}

.breakdown-list {
  display: grid;
}

.breakdown-row {
  display: grid;
  grid-template-columns: 38px minmax(0, 1fr) auto;
  align-items: center;
  gap: 16px;
  padding: 18px 0;
  border-top: 1px solid #ece8e0;
}

.breakdown-row:first-child {
  border-top: 0;
}

.amount-indicator {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border-radius: 11px;
  font-size: 20px;
  font-weight: 500;
}

.amount-indicator.positive {
  color: var(--green);
  background: var(--green-soft);
}

.amount-indicator.negative {
  color: #982f2f;
  background: #f7dddd;
}

.breakdown-main strong {
  display: block;
  margin-bottom: 4px;
}

.breakdown-main p {
  margin-bottom: 4px;
  color: #5d645e;
  font-size: 13px;
}

.breakdown-main small {
  color: #929792;
  font-size: 11px;
}

.positive-money,
.negative-money {
  font-size: 16px;
  font-variant-numeric: tabular-nums;
}

.positive-money {
  color: var(--green);
}

.negative-money {
  color: #9b3535;
}

.breakdown-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8px;
  padding: 21px 20px;
  color: white;
  background: var(--ink);
  border-radius: 14px;
}

.breakdown-total strong {
  font-size: 23px;
}

.empty-state {
  padding: 45px 20px;
  color: var(--muted);
  text-align: center;
  background: #faf8f3;
  border: 1px dashed var(--line);
  border-radius: 15px;
}

@media (max-width: 1050px) {
  .metric-grid.four {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 900px) {
  .login-shell {
    grid-template-columns: 1fr;
  }

  .login-brand-panel {
    min-height: 430px;
    padding: 55px 35px;
  }

  .login-brand-panel h1 {
    font-size: 50px;
  }

  .login-card-wrap {
    padding: 35px 22px;
  }

  .site-header {
    padding: 0 22px;
  }

  .period-row {
    grid-template-columns: 55px 1fr auto;
  }

  .period-total,
  .row-arrow {
    display: none;
  }
}

@media (max-width: 720px) {
  h1 {
    font-size: 37px;
  }

  .page-container,
  .page-container.narrow {
    width: min(100% - 28px, 1240px);
    padding-top: 34px;
  }

  .site-header {
    min-height: 67px;
  }

  .brand-link small,
  .header-user > div {
    display: none;
  }

  .hero-row,
  .hero-row.compact,
  .employee-summary-card {
    align-items: stretch;
    flex-direction: column;
  }

  .hero-date {
    min-width: 0;
  }

  .metric-grid,
  .metric-grid.four,
  .mini-metrics {
    grid-template-columns: 1fr;
  }

  .metric-card {
    min-height: auto;
  }

  .section-heading.responsive {
    align-items: stretch;
    flex-direction: column;
  }

  .filter-form {
    grid-template-columns: 1fr auto;
  }

  .content-card {
    padding: 20px 14px;
    border-radius: 18px;
  }

  .payroll-table th:nth-child(2),
  .payroll-table td:nth-child(2) {
    display: none;
  }

  .payroll-table th,
  .payroll-table td {
    padding: 13px 10px;
  }

  .title-with-status {
    align-items: flex-start;
    flex-direction: column;
    gap: 7px;
  }

  .employee-summary-card {
    padding: 27px 23px;
  }

  .salary-total {
    min-width: 0;
    padding: 22px 0 0;
    text-align: left;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    border-left: 0;
  }

  .breakdown-row {
    grid-template-columns: 34px 1fr;
  }

  .breakdown-row > strong:last-child {
    grid-column: 2;
  }
}

.skeleton {
  overflow: hidden;
  background: #e8e4dc;
  border-radius: 16px;
  position: relative;
}

.skeleton::after {
  content: "";
  position: absolute;
  inset: 0;
  transform: translateX(-100%);
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.62), transparent);
  animation: shimmer 1.35s infinite;
}

.skeleton-title {
  width: min(420px, 80%);
  height: 55px;
  margin-bottom: 35px;
}

.skeleton-card {
  height: 158px;
}

.skeleton-panel {
  height: 420px;
  margin-top: 25px;
}

@keyframes shimmer {
  100% { transform: translateX(100%); }
}
